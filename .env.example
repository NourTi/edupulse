# EduPulse Environment Configuration
DATABASE_URL=

# Session signing secret: Any random string of 32+ characters (e.g. openssl rand -hex 32)
# Automatically falls back to a safe default if left blank.
JWT_SECRET=

# Owner / Administrator identification: The email or openId of the primary admin (e.g. rafaraf201@gmail.com)
OWNER_OPEN_ID=
OWNER_NAME="مؤسس EduPulse"
PORT=3000

# Client variables
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Auth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_MAGIC_PUBLISHABLE_KEY=
MAGIC_SECRET_KEY=

# AI Services
GEMINI_API_KEY=
VENICE_INFERENCE_API_KEY=
VENICE_BASE_URL=
VENICE_MODEL=

# Database startup migration flag
AUTO_MIGRATE=false
