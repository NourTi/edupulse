# ==============================================================================
# EduPulse Environment Configuration (Render / Production / Local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DATABASE & SESSION (Render Deployment)
# ------------------------------------------------------------------------------
# Database Connection String (PostgreSQL, MySQL, or TiDB)
# Example (Render PostgreSQL): postgresql://user:password@dpg-xxx.render.com/edupulse
DATABASE_URL=

# Session signing secret: Any random string of 32+ characters
# If left blank, automatically falls back to a safe built-in secret.
JWT_SECRET=

# Owner / Primary Administrator Identification
OWNER_OPEN_ID=
OWNER_NAME="مؤسس EduPulse"
PORT=3000

# Automatically run database migrations on server startup (set to true if you have a database)
AUTO_MIGRATE=false

# ------------------------------------------------------------------------------
# 2. AI ENGINES & MODEL CAPABILITIES
# ------------------------------------------------------------------------------
# Google Gemini API Key (for student intelligence & assistant capabilities)
GEMINI_API_KEY=

# Optional: Venice Inference API
VENICE_INFERENCE_API_KEY=
VENICE_BASE_URL=
VENICE_MODEL=

# ------------------------------------------------------------------------------
# 3. NEWLY INTEGRATED SERVICE & ACADEMIC APIS (OPTIONAL - SAFE DEFAULTS INCLUDED)
# None of these will crash the app if left blank on Render!
# Each engine includes an active default key, free public endpoint, or offline sovereign engine.
# ------------------------------------------------------------------------------

# NumLookupAPI (Phone verification, carrier detection, SMS OTP)
# https://numlookupapi.com/
# Pre-loaded with an active default key in code; provide your own if you want private quota.
NUMLOOKUP_API_KEY=

# Data.gov API Key (College Scorecard - higher-education & guidance dataset)
# https://api.data.gov/signup/ (Free instant signup)
# If empty, automatically uses data.gov's public "DEMO_KEY".
DATA_GOV_API_KEY=

# Wolfram|Alpha LLM / Short Answers App ID (Step-by-step calculus & STEM solver)
# https://developer.wolframalpha.com/
# If empty, EduPulse uses its built-in offline Algerian STEM & calculus solver engine.
WOLFRAM_APP_ID=

# APITemplate.io (Cloud PDF/Image document generation for lesson plans & certificates)
# https://apitemplate.io/
# If empty, EduPulse uses its built-in high-fidelity A4 print & PDF renderer.
APITEMPLATE_API_KEY=

# Quoterism API Key (Philosophical & academic quotes for exam headers & lesson plans)
# https://www.quoterism.com/developer
# If empty, EduPulse uses its built-in curated pedagogical Arabic/English quote library.
QUOTERISM_API_KEY=

# Personality.fyi API Key (Student cognitive profiles, MBTI & Big Five assessments)
# https://personality.fyi/api/
# If empty, EduPulse uses its built-in pedagogical personality assessment engine.
PERSONALITY_FYI_API_KEY=

# Apify Cambridge Dictionary & IPA Scraper Token (For English educators)
# https://apify.com/jungle_synthesizer/cambridge-dictionary-definition-ipa-scraper
# Includes active default token in code; override with your private Apify token if desired.
APIFY_CAMBRIDGE_TOKEN=

# ------------------------------------------------------------------------------
# 4. FREE PUBLIC APIS (NO API KEYS REQUIRED)
# ------------------------------------------------------------------------------
# - Internet Archive (Archive.org): Open Public API for books, papers, historical BAC exams.
# - Open Science Framework (OSF / SHARE API): Open Public API for preprints & datasets.
# - OpenAlex: Open Academic Graph (free email polite pool).
# - CrossRef: Open DOI metadata (free polite pool).
OPENALEX_API_KEY=
CROSSREF_MAILTO=

# ------------------------------------------------------------------------------
# 5. OPTIONAL AUTH & CLIENT VARIABLES
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_MAGIC_PUBLISHABLE_KEY=
MAGIC_SECRET_KEY=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
