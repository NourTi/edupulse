+  getUserByOpenId: (openId: string) =>
+    usersTable.findWhere(row => row.openId === openId),
+  getUserById: (userId: number) =>
+    usersTable.findWhere(row => row.id === userId),
+  getUserByEmail: (email: string) =>
+    usersTable.findWhere(
+      row => (row.email ?? "").toLowerCase() === email.toLowerCase()
+    ),
+  async createPasswordUser(input: Row) {
+    const user = {
+      id: usersTable.all().length + 1,
+      loginMethod: "password",
+      role: "user",
+      status: "active",
+      mustChangePassword: false,
+      passwordChangedAt: now(),
+      createdAt: now(),
+      updatedAt: now(),
+      lastSignedIn: now(),
+      openId: `guest-${input.email}`,
