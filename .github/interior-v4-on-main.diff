--- /dev/null
+++ b/server/guestStore.ts
@@ -0,0 +1,1384 @@
+/**
+ * EduPulse guest store â€” a real, in-memory institution for demos and sandboxes.
+ *
+ * Why this exists: every workspace action goes through a tRPC procedure that writes to
+ * MySQL/TiDB. With no database reachable (evaluation sandbox, offline laptop, a fresh
+ * Render service before migration) sign-up itself fails, so the workspace never opens
+ * and nothing looks clickable. This store keeps the SAME procedures, the SAME return
+ * shapes and the SAME role checks, backed by in-memory rows.
+ *
+ * It is only live when `EDUPULSE_GUEST` is set to a truthy value. Production without
+ * that variable behaves exactly as before and hits the real database.
+ */
+import { readFileSync, readdirSync, existsSync } from "node:fs";
+import path from "node:path";
+import { localCorpusFallback } from "./creator/research";
+
+export const GUEST_INSTITUTION = "inst_guest";
+export const GUEST_USER_ID = 1;
+const GUEST_LEARNER_USER_ID = 2;
+export const GUEST_LEARNER_EMAIL = "student@edupulse.local";
+const DAY = 86_400_000;
+const now = () => new Date();
+
+const id = (prefix: string) =>
+  `${prefix}_${Math.random().toString(36).slice(2, 12)}`;
+
+type Row = Record<string, any>;
+
+const table = <T extends Row>(rows: T[] = []) => ({
+  rows,
+  all: () => rows,
+  insert(row: T) {
+    rows.push(row);
+    return row;
+  },
+  findWhere(predicate: (row: T) => boolean) {
+    return rows.find(predicate);
+  },
+  filter(predicate: (row: T) => boolean) {
+    return rows.filter(predicate);
+  },
+  update(target: T, patch: Row) {
+    Object.assign(target, patch, { updatedAt: now() });
+    return target;
+  },
+});
+
+function buildCorpusSource() {
+  const dir = path.resolve(process.cwd(), "docs", "algerian-corpus");
+  if (!existsSync(dir)) return [] as Row[];
+  return readdirSync(dir)
+    .filter(name => name.endsWith(".md"))
+    .map(name => ({
+      file: name,
+      text: readFileSync(path.join(dir, name), "utf8"),
+    }))
+    .filter(entry => entry.text.length > 200)
+    .map((entry, index) => {
+      const blocks = entry.text
+        .split(/\n{2,}/)
+        .map(block => block.trim())
+        .filter(block => block.length > 90);
+      return {
+        id: `kc_corpus_${index}`,
+        sourceId: "src_corpus",
+        ordinal: index,
+        content: blocks.slice(0, 12).join("\n\n").slice(0, 12_000),
+        createdAt: now(),
+      };
+    })
+    .filter(chunk => chunk.content.length > 120);
+}
+
+function seedLearners() {
