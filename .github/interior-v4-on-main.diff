+export async function listWrongQuizItems(
+  institutionId: string,
+  learnerId: string
+): Promise<{ quizId: string; itemId: string; title: string }[]> {
+  if (guestEnabled()) return guestCall("listWrongQuizItems", arguments);
+
+  const db = await getDb();
+  if (!db) return [];
+  const rows = await db
+    .select({ quizId: quizAttempts.quizId, resultJson: quizAttempts.resultJson, title: quizzes.title })
+    .from(quizAttempts)
+    .innerJoin(quizzes, eq(quizzes.id, quizAttempts.quizId))
+    .where(and(eq(quizAttempts.institutionId, institutionId), eq(quizAttempts.learnerId, learnerId)))
+    .orderBy(desc(quizAttempts.createdAt))
+    .limit(20);
+  const out: { quizId: string; itemId: string; title: string }[] = [];
+  const seen = new Set<string>();
+  for (const row of rows) {
+    if (!row.resultJson) continue;
+    try {
+      const parsed = JSON.parse(row.resultJson) as { wrongItemIds?: string[] };
+      for (const itemId of parsed.wrongItemIds ?? []) {
+        const key = `${row.quizId}:${itemId}`;
+        if (seen.has(key)) continue;
+        seen.add(key);
+        out.push({ quizId: row.quizId, itemId, title: row.title });
+      }
+    } catch {
+      // A malformed row must not hide the rest of the diagnostics.
+    }
+  }
+  return out;
+}
