+function excerptSection(
+  plan: { title: string; instruction: string },
+  ranked: RankedChunk[]
+): ReportSection {
+  const picked = ranked.slice(0, 3);
+  const lines = picked
+    .map((chunk, index) => {
+      const snippet =
+        chunk.snippets[index % Math.max(1, chunk.snippets.length)] ??
+        chunk.content.slice(0, 220);
+      return `${snippet} [S${index + 1}]`;
+    })
