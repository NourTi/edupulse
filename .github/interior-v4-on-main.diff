+// â”€â”€ Material â†’ artifacts (Studyield factory, no model required) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
+export type DraftFlashcard = { front: string; back: string };
+export type DraftQuizItem = {
+  q: string;
+  options: string[];
+  answer: string;
+  explanation: string;
+};
+
+function splitTerms(sentence: string): { term: string; rest: string } | null {
+  const english = sentence.match(
+    /^([A-ZÃ€-Ã–Ã˜-Ãž][\wÃ€-Ã¿'â€™-]{2,40}(?:\s+[\wÃ€-Ã¿'â€™-]{2,40}){0,3})\s+(?:is|are|means|refers to|dÃ©signe|consiste en|renvoie Ã )\s+(.{25,240})[.!?]?$/
+  );
+  if (english?.[1] && english[2])
+    return { term: english[1].trim(), rest: english[2].trim() };
+  const colonLabel = sentence.match(
+    /^([A-ZÃ€-Ã–Ã˜-Ãž][\wÃ€-Ã¿'â€™-]{2,40}(?:\s+[\wÃ€-Ã¿'â€™-]{2,40}){0,4})\s*:\s*(.{25,240})$/
+  );
+  if (colonLabel?.[1] && colonLabel[2])
+    return { term: colonLabel[1].trim(), rest: colonLabel[2].trim() };
+  const arabic = sentence.match(
+    /^([\u0600-\u06FF][\u0600-\u06FF\s]{2,34})\s*[:\-â€“]\s*(.{25,240})$/
+  );
+  if (arabic?.[1] && arabic[2])
+    return { term: arabic[1].trim(), rest: arabic[2].trim() };
+  return null;
+}
+
+export function artifactsFromText(
+  text: string,
+  options: { maxCards?: number; maxItems?: number } = {}
+) {
+  const sentences = sentenceList(text);
+  const cards: DraftFlashcard[] = [];
+  const seen = new Set<string>();
+  for (const sentence of sentences) {
+    const split = splitTerms(sentence);
+    if (!split) continue;
+    const key = split.term.toLowerCase();
+    if (seen.has(key)) continue;
+    seen.add(key);
+    cards.push({
+      front: `What is â€œ${split.term}â€?`,
+      back: split.rest.replace(/\s+/g, " ").slice(0, 280),
+    });
+    if (cards.length >= (options.maxCards ?? 6)) break;
+  }
+  const clozePool = sentences.filter(
+    sentence => sentence.length > 60 && sentence.length < 320
+  );
+  const items: DraftQuizItem[] = clozePool
+    .slice(0, options.maxItems ?? 4)
+    .map((sentence, index) => {
+      const words = sentence.split(/\s+/);
+      const targetIndex = Math.min(
+        words.length - 1,
+        Math.floor(words.length * 0.6)
+      );
+      const answer = (words[targetIndex] ?? "").replace(/[^\w'â€™-]/g, "");
+      if (!answer || answer.length < 4) return null;
+      const distractors = Array.from(
+        new Set(
+          words
+            .map(w => w.replace(/[^\w'â€™-]/g, ""))
+            .filter(
+              w => w.length >= 4 && w !== answer && !STOP.has(w.toLowerCase())
+            )
+        )
+      );
+      const options = [answer, ...distractors.slice(0, 3).map(d => d)];
+      if (options.length < 4) return null;
+      const cloze = sentence.replace(
+        new RegExp(`\\b${answer.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}\\b`),
+        "______"
+      );
+      return {
+        q: `Complete the passage from your material (${index + 1}): ${cloze}`,
+        options: options.sort(() => 0.5 - Math.random()),
+        answer,
+        explanation: `The blank is restored from the source text, not from the model. Cite the passage when you review it.`,
+      } satisfies DraftQuizItem;
+    })
+    .filter((item): item is DraftQuizItem => Boolean(item));
+  const notes = sentences.slice(0, 8).map(sentence => `- ${sentence}`);
+  return { cards, items, notes };
+}
+
+// â”€â”€ Mastery roadmap + honest prediction (Studivexa translation) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
+export type RoadmapNode = {
+  nodeId: string;
+  unit: string;
+  mastery: number;
+  status: "green" | "yellow" | "red";
+  evidence: number;
+};
+
+export function buildRoadmap(input: {
+  nodes: Array<{ id: string; unit: string; competencyEn?: string | null }>;
+  edges: Array<{ fromNodeId: string; toNodeId: string; kind?: string | null }>;
+  evidence: Record<string, { mastery: number; cards: number }>;
+  attendance?: number | null;
+}) {
+  const nodes: RoadmapNode[] = input.nodes.map(node => {
+    const entry = input.evidence[node.id];
+    const mastery = entry ? Math.max(0, Math.min(1, entry.mastery)) : 0;
+    return {
+      nodeId: node.id,
+      unit: node.unit,
+      mastery: Math.round(mastery * 100) / 100,
+      evidence: entry?.cards ?? 0,
+      status: mastery >= 0.75 ? "green" : mastery >= 0.45 ? "yellow" : "red",
+    };
+  });
+  const byId = new Map(nodes.map(node => [node.nodeId, node]));
+  const blocked = nodes.filter(node =>
+    input.edges.some(
+      edge =>
+        edge.toNodeId === node.nodeId &&
+        (edge.kind ?? "prerequisite") === "prerequisite" &&
+        (byId.get(edge.fromNodeId)?.mastery ?? 1) < 0.45
+    )
+  );
+  const avg = nodes.length
+    ? nodes.reduce((sum, node) => sum + node.mastery, 0) / nodes.length
+    : 0;
+  const attendance =
+    input.attendance === null || input.attendance === undefined
+      ? null
+      : Math.max(0, Math.min(100, input.attendance));
+  // Transparent projection: mastery drives 75% of it, attendance 25%. Assumed attendance is never used to inflate a score.
+  const predictedScore =
+    nodes.length && attendance !== null
+      ? Math.round((avg * 0.75 + (attendance / 100) * 0.25) * 20 * 10) / 10
+      : null;
+  return {
+    nodes,
+    blockedByPrerequisite: blocked.map(node => ({
+      nodeId: node.nodeId,
+      unit: node.unit,
+    })),
+    cohortMastery: Math.round(avg * 100) / 100,
+    prediction: {
+      metric: "projected /20",
+      value: predictedScore,
+      available: predictedScore !== null,
+      band:
+        predictedScore === null
+          ? "not enough evidence â€” record quiz, card, and attendance data first"
+          : predictedScore >= 14
+            ? "comfortable pass"
+            : predictedScore >= 10
+              ? "pass, needs consolidation"
+              : "at risk if the trajectory holds",
+      formula: "(average mastery Ã— 0.75 + attendance Ã— 0.25) Ã— 20",
+      disclaimer:
+        "A trajectory marker for the facilitator, not a promise and never shared with guardians as a grade.",
+    },
+  };
+}
+
+// â”€â”€ one-call offline research: corpus in, report + artifacts out â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
+/**
+ * The whole research loop in a single pure function: rank the corpus with BM25,
+ * write the cited report, and draft study artifacts from the top evidence. Used by
+ * the tRPC layer and directly by tests, so the loop can be proven with no database
+ * and no network.
+ */
+export function runResearchQuery(input: {
+  query: string;
+  corpus?: CorpusChunk[];
+  limit?: number;
+  useFallback?: boolean;
+  withArtifacts?: boolean;
+}) {
+  const own = input.corpus ?? [];
+  const fallback =
+    input.useFallback === false || own.length
+      ? { chunks: [] as CorpusChunk[], origin: "disabled" }
+      : localCorpusFallback();
+  const corpus = own.length ? own : fallback.chunks;
+  const ranked = bm25(input.query, corpus, { limit: input.limit ?? 8 });
+  const built = buildReport({
+    query: input.query,
+    ranked,
+    institutionChunks: own.length,
+    fallbackOrigin: fallback.origin,
+    fallbackUsed: own.length === 0 && fallback.chunks.length > 0,
+  });
+  const artifacts =
+    input.withArtifacts === false
+      ? null
+      : artifactsFromText(
+          ranked
+            .slice(0, 3)
+            .map(chunk => `${chunk.title}. ${chunk.content}`)
+            .join("\n\n")
+        );
+  return {
+    ...built,
+    corpusSize: corpus.length,
+    ranked: ranked.map(chunk => ({
+      id: chunk.id,
+      title: chunk.title,
+      score: chunk.score,
+      sourceId: chunk.sourceId,
+    })),
+    artifacts,
+  };
+}
+
+// â”€â”€ notebook scoping + Anki export (pure, so the router stays thin) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
+export function notebookScope(
+  chunks: CorpusChunk[],
+  notebook: { chunkIdsJson?: string | null },
+  question: string,
+  limit = 4
+) {
+  let ids: string[] | null = null;
+  try {
+    ids = notebook.chunkIdsJson
+      ? (JSON.parse(notebook.chunkIdsJson) as string[])
+      : null;
+  } catch {
+    ids = null;
+  }
+  const scoped =
+    ids && ids.length
+      ? chunks.filter(chunk => ids!.includes(chunk.id))
+      : chunks;
+  const ranked = bm25(question, scoped, { limit });
+  const citations = ranked.map((chunk, index) => ({
+    ref: `N${index + 1}`,
+    title: chunk.title,
+    sourceId: chunk.sourceId,
+    url: chunk.sourceUrl ?? null,
+    score: chunk.score,
+  }));
+  const answer = ranked.length
+    ? ranked
+        .map(
+          (chunk, index) =>
+            `${chunk.snippets[0] ?? chunk.content.slice(0, 260)} [N${index + 1}]`
+        )
+        .join("\n")
+    : `This notebook holds ${scoped.length} stored passage(s), none matching this question. Add the source passage to the notebook or rephrase â€” I will not answer from outside your notebook.`;
+  return { passages: scoped.length, answer, citations };
+}
+
+/** Anki-ready tab-separated body: header + one row per card, tags carry competency and due date. */
+export function flashcardTsv(
+  rows: Array<{
+    front: string;
+    back: string;
+    frontAr?: string | null;
+    backAr?: string | null;
+    competencyId?: string | null;
+    dueAt?: Date | string | null;
+  }>
+) {
+  const cleanCell = (value: string) => value.replace(/[\t\r\n]+/g, " ").trim();
+  return [
+    "Front\tBack\tTags",
+    ...rows.map(row => {
+      const front = cleanCell(
+        [row.front, row.frontAr].filter(Boolean).join(" / ")
+      );
+      const back = cleanCell(
+        [row.back, row.backAr].filter(Boolean).join(" / ")
+      );
+      const due = row.dueAt
+        ? row.dueAt instanceof Date
+          ? row.dueAt.toISOString().slice(0, 10)
+          : String(row.dueAt).slice(0, 10)
+        : null;
+      const tags = cleanCell(
+        [
+          "EduPulse",
+          row.competencyId ?? "general",
+          due ? `due:${due}` : "",
+        ].join(" ")
+      );
+      return `${front}\t${back}\t${tags}`;
+    }),
+  ].join("\n");
+}
