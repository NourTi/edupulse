+}
+
+// â”€â”€ BM25 (Okapi, k1=1.4, b=0.75) â€” real ranking over your own corpus â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
+export type RankedChunk = CorpusChunk & { score: number; snippets: string[] };
+
+export function bm25(
+  query: string,
+  corpus: CorpusChunk[],
+  options: { limit?: number; snippets?: number } = {}
+): RankedChunk[] {
+  const limit = options.limit ?? 6;
+  const wanted = Array.from(new Set(tokenize(query)));
+  if (!wanted.length || !corpus.length) return [];
+  const docs = corpus.map(chunk => tokenize(`${chunk.title} ${chunk.content}`));
+  const avg = docs.reduce((sum, doc) => sum + doc.length, 0) / docs.length || 1;
+  const k1 = 1.4;
+  const b = 0.75;
+  const docFrequency = new Map<string, number>();
+  for (const doc of docs) {
+    for (const term of Array.from(new Set(doc)))
+      docFrequency.set(term, (docFrequency.get(term) ?? 0) + 1);
+  }
+  const scored = corpus.map((chunk, index) => {
+    const doc = docs[index];
+    const length = doc.length || 1;
+    const frequency = new Map<string, number>();
+    for (const term of doc) frequency.set(term, (frequency.get(term) ?? 0) + 1);
+    let score = 0;
+    for (const term of wanted) {
+      const tf = frequency.get(term) ?? 0;
+      if (!tf) continue;
+      const df = docFrequency.get(term) ?? 1;
+      const idf = Math.log(1 + (docs.length - df + 0.5) / (df + 0.5));
+      score +=
+        idf * ((tf * (k1 + 1)) / (tf + k1 * (1 - b + b * (length / avg))));
+    }
+    return {
+      ...chunk,
+      score: Math.round(score * 1000) / 1000,
+      snippets: [] as string[],
+    };
+  });
+  const ranked = scored
+    .filter(doc => doc.score > 0)
+    .sort((a, z) => z.score - a.score)
+    .slice(0, limit);
+  const querySet = new Set(wanted);
+  return ranked.map(doc => {
+    const sentences = sentenceList(doc.content);
+    const snippets = sentences
+      .map(sentence => ({
+        sentence,
+        hits: tokenize(sentence).filter(token => querySet.has(token)).length,
+      }))
+      .filter(entry => entry.hits > 0)
+      .sort((a, z) => z.hits - a.hits)
+      .slice(0, options.snippets ?? 2)
+      .map(entry => entry.sentence.slice(0, 320));
+    return {
+      ...doc,
+      snippets: snippets.length ? snippets : [doc.content.slice(0, 260)],
+    };
+  });
+}
+
+// â”€â”€ Offline-safe fallback corpus: the Algerian programme files in the repo â”€â”€â”€â”€
+// Used only when the institution has no approved sources yet (fresh install, no DB,
+// or empty knowledge base). Clearly labelled in the report â€” never presented as
+// institution data.
+export type FallbackCorpus = { chunks: CorpusChunk[]; origin: string };
+let fallbackCache: FallbackCorpus | null = null;
+
+export function localCorpusFallback(
+  dir = path.resolve(process.cwd(), "docs", "algerian-corpus")
+): FallbackCorpus {
+  if (fallbackCache) return fallbackCache;
+  const chunks: CorpusChunk[] = [];
+  try {
+    for (const file of readdirSync(dir)) {
+      if (!file.endsWith(".md")) continue;
+      const raw = readFileSync(path.join(dir, file), "utf8");
+      const titleMatch = raw.match(/^#\s+(.+)$/m);
+      const title = titleMatch?.[1]?.trim() ?? file.replace(/\.md$/, "");
+      raw
+        .split(/\n{2,}/)
+        .map(block =>
+          block
+            .replace(/^[#>*\-|`\s]+/, "")
+            .replace(/\s+/g, " ")
+            .trim()
+        )
+        .filter(block => block.length > 90)
+        .slice(0, 18)
+        .forEach((block, index) => {
+          chunks.push({
+            id: `fb_${file.replace(/\W/g, "_")}_${index}`,
+            sourceId: `file:${file}`,
+            title: `${title} (${file})`,
+            content: block.slice(0, 1400),
+            sourceUrl: null,
+          });
+        });
+    }
+  } catch {
+    // Missing folder just means no fallback; the report says so plainly.
+  }
+  fallbackCache = {
+    chunks,
+    origin: chunks.length
+      ? `docs/algerian-corpus (${chunks.length} blocks)`
+      : "none",
+  };
+  return fallbackCache;
+}
