+    `_Generated ${new Date().toISOString()} Â· corpus: ${input.institutionChunks} approved chunk(s)${input.fallbackUsed ? ` + offline reference (${input.fallbackOrigin})` : ""} Â· method: BM25 ranking, extractive synthesis_`,
