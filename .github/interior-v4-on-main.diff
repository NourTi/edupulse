+import { describe, expect, it } from "vitest";
+import { resolveEntry } from "./entryScreen";
+
+describe("resolveEntry", () => {
+  it("opens the workspace directly when demo mode is on", () => {
+    expect(
+      resolveEntry({
+        demoEnabled: true,
+        signedIn: false,
+        heroRequested: false,
+        deepView: null,
+      })
+    ).toEqual({ screen: "workspace", view: null });
+  });
+
+  it("opens the workspace for a live session on a real deployment", () => {
+    expect(
+      resolveEntry({
+        demoEnabled: false,
+        signedIn: true,
+        heroRequested: false,
+        deepView: null,
+      })
+    ).toEqual({ screen: "workspace", view: null });
+  });
+
+  it("sends a signed-out visitor to sign-in, not to the marketing hero", () => {
+    expect(
+      resolveEntry({
+        demoEnabled: false,
+        signedIn: false,
+        heroRequested: false,
+        deepView: null,
+      })
+    ).toEqual({ screen: "access", view: null });
+  });
+
+  it("still honours ?hero=1 even with a session in effect", () => {
+    expect(
+      resolveEntry({
+        demoEnabled: true,
+        signedIn: true,
+        heroRequested: true,
+        deepView: "portal",
+      })
+    ).toEqual({ screen: "landing", view: null });
+  });
+
+  it("carries a deep-linked view into the workspace", () => {
+    expect(
+      resolveEntry({
+        demoEnabled: true,
+        signedIn: false,
+        heroRequested: false,
+        deepView: "research",
+      })
+    ).toEqual({ screen: "workspace", view: "research" });
+  });
+
+  it("holds a deep-linked view across the sign-in step", () => {
+    expect(
+      resolveEntry({
+        demoEnabled: false,
+        signedIn: false,
+        heroRequested: false,
+        deepView: "portal",
+      })
+    ).toEqual({ screen: "access", view: "portal" });
+  });
+});
diff --git a/client/src/components/entryScreen.ts b/client/src/components/entryScreen.ts
