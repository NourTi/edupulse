+
+function labelFromSentence(sentence: string): string | null {
+  const defined = sentence.match(
+    /^([A-ZÃ€-Ã–Ã˜-Ãž][\wÃ€-Ã¿'â€™-]{2,28}(?:\s+[A-ZÃ€-Ã–Ã˜-Ãž][\wÃ€-Ã¿'â€™-]{2,28}){0,3})\s+(?:is|are|means|refers to|consists of|requires)\b/i
+  );
+  if (defined?.[1]) return defined[1].trim();
+  const arabic = sentence.match(
+    /^([\u0600-\u06FF][\u0600-\u06FF\s]{3,40}?)\s*[:\-â€“]\s*/
+  );
+  if (arabic?.[1]) return arabic[1].trim();
+  const bullet = sentence.match(
+    /^([A-ZÃ€-Ã–Ã˜-Ãž][\wÃ€-Ã¿'â€™-]{3,30}(?:\s+[\wÃ€-Ã¿'â€™-]{3,30}){0,3})\b/
+  );
+  return bullet?.[1]?.trim() ?? null;
+}
+
+const STRUCTURAL_LABELS = new Set([
+  "citations",
+  "sources",
+  "finding",
+  "summary",
+  "note",
+  "notes",
+  "method",
+  "generated",
+  "limits",
+  "conclusion",
+]);
+
+export function extractConcepts(
+  chunks: Array<{ title: string; content: string }>,
+  limit = 10
+): ConceptCandidate[] {
+  const found = new Map<string, { occurrences: number; evidence: string }>();
+  for (const chunk of chunks) {
+    for (const sentence of sentenceList(chunk.content)) {
+      const label = labelFromSentence(sentence);
+      if (!label) continue;
+      const key = label.toLowerCase();
+      if (key.length < 4 || STRUCTURAL_LABELS.has(key)) continue;
+      const current = found.get(key);
+      if (current) current.occurrences += 1;
+      else found.set(key, { occurrences: 1, evidence: sentence.slice(0, 300) });
+    }
+  }
+  return Array.from(found.entries())
+    .map(([label, value]) => ({ label, ...value }))
+    .sort(
+      (a, z) => z.occurrences - a.occurrences || a.label.localeCompare(z.label)
+    )
+    .slice(0, limit);
+}
+
+export function extractEdges(
+  concepts: ConceptCandidate[],
+  chunks: Array<{ title: string; content: string }>
+): EdgeCandidate[] {
+  if (concepts.length < 2) return [];
+  const edges = new Map<string, EdgeCandidate>();
+  for (const chunk of chunks) {
+    for (const sentence of sentenceList(chunk.content)) {
+      const lowered = sentence.toLowerCase();
+      const present = concepts.filter(concept =>
+        lowered.includes(concept.label.toLowerCase())
+      );
+      for (let i = 0; i < present.length; i += 1) {
+        for (let j = i + 1; j < present.length; j += 1) {
+          const key = `${present[i].label.toLowerCase()}â†’${present[j].label.toLowerCase()}`;
+          const existing = edges.get(key);
+          const causal =
+            /\b(because|therefore|requires|leads to|depends on|before|prerequisite|ÙŠØ­ØªØ§Ø¬|Ù‚Ø¨Ù„|Ø¨Ù†Ø§Ø¡ Ø¹Ù„Ù‰)\b/i.test(
+              sentence
+            );
+          if (existing) existing.weight += 1;
+          else
+            edges.set(key, {
+              from: present[i].label,
+              to: present[j].label,
+              weight: 1,
+              kind: causal ? "prerequisite" : "related",
+            });
+        }
+      }
+    }
+  }
+  return Array.from(edges.values())
+    .sort((a, z) => z.weight - a.weight)
+    .slice(0, 14);
+}
