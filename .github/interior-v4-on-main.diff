+describe("parsePairs", () => {
+  it("reads every separator the studio or a learner might produce", () => {
+    expect(parsePairs("a=1\nb â†’ 2\nc|3\nd\t4")).toEqual([
+      ["a", "1"],
+      ["b", "2"],
+      ["c", "3"],
+      ["d", "4"],
+    ]);
+    expect(parsePairs(["x=y", "z=w"])).toEqual([
+      ["x", "y"],
+      ["z", "w"],
+    ]);
+  });
+});
+
+describe("gradeQuiz", () => {
+  const items = normalizeItems(
+    [
+      { id: "m1", q: "mcq", a: "Words correct per minute", options: ["Words correct per minute", "Pages"] },
+      { id: "m2", q: "tf", a: "False", options: ["True", "False"] },
+      { id: "m3", q: "fill", a: "exit ticket" },
+      { id: "m4", q: "match", a: ["a|1", "b|2"] },
+    ],
+    QUIZ_ID
