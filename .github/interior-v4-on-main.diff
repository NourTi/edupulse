+/** A stored JSON blob the browser may half-write: never throw on it, just yield nothing. */
+function safeJson(raw: string | null | undefined): unknown {
+  if (!raw) return [];
+  try {
+    return JSON.parse(raw);
+  } catch {
+    return [];
+  }
+}
+
+/** True when the caller holds a staff membership in this institution. */
+async function isStaffScope(ctx: { user: { id: number } }, institutionId: string) {
+  const membership = await membershipOf(ctx, institutionId);
+  return Boolean(membership && (STAFF_ROLES as readonly string[]).includes(membership.role));
+}
+
+/**
+ * Which learners the caller may act on. Staff see the institution roster; a student
+ * resolves only their own linked record, a guardian only the children they are linked to.
+ * Everything learner-facing funnels through this so "my dashboard" cannot widen into
+ * "the school's dashboard".
+ */
+async function visibleLearnerIds(
+  ctx: { user: { id: number } },
+  inst: string,
+  role: string
+): Promise<string[]> {
+  const { getStudentLearner, listGuardianLearners, listLearners } = await import(
+    "../db"
+  );
+  if (role === "student") {
+    const own = await getStudentLearner(inst, ctx.user.id);
+    return own ? [own.learner.id] : [];
+  }
+  if (role === "guardian") {
+    const rows = await listGuardianLearners(inst, ctx.user.id);
+    return rows.map(row => row.learner.id);
+  }
+  return (await listLearners(inst)).map(row => row.id);
+}
+
+/**
+ * Resolve the learner a read or write is scoped to. Staff may name any learner of their
+ * institution (the roster is checked only when they do not name one); students and
+ * guardians are pinned to their own records whatever they send, and never touch the roster.
+ */
+async function resolveLearnerScope(
+  ctx: { user: { id: number } },
+  inst: string,
+  requested?: string
+): Promise<string | null> {
+  const membership = await membershipOf(ctx, inst);
+  if (!membership) return null;
+  const learnerBound = membership.role === "student" || membership.role === "guardian";
+  if (!learnerBound && requested) return requested;
+  const allowed = await visibleLearnerIds(ctx, inst, membership.role);
+  if (!learnerBound) return requested && allowed.includes(requested) ? requested : (allowed[0] ?? null);
+  return requested ? (allowed.includes(requested) ? requested : null) : (allowed[0] ?? null);
+}
+
+/**
