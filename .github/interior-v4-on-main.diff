+export function tokenize(value: string): string[] {
+  return (value.toLowerCase().match(WORD) ?? []).filter(
+    token => token.length > 2 && !STOP.has(token)
+  );
+}
+
+function sentenceList(content: string) {
+  const lines = content
+    .replace(/\[[SN]\d+\]/g, "")
+    .replace(/^_[^_\n]{10,400}_$/gm, "")
+    .split(/\n+/)
+    .map(line =>
+      line
+        .replace(/^#+[ \t]*/g, "")
+        .replace(/\*\*|__|`/g, "")
+        .replace(/^Citations?:[ \t]*/i, "")
+        .replace(/^[-*][ \t]+/, "")
+        .replace(/\s*[â€”â€“-]\s*\([^)]{5,200}\)\s*\.?\s*$/i, "")
+        .replace(/\s+/g, " ")
+        .trim()
+    )
+    .filter(line => line.length > 24);
+  return lines.flatMap(line =>
+    line
+      .split(/(?<=[.!ØŸ?])\s+/)
+      .map(part => part.trim())
+      .filter(part => part.length > 24)
