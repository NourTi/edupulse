+/** Cards grouped by competency â€” the evidence layer for roadmap and mastery. */
+export async function listLearnerEvidenceByCompetency(
+  institutionId: string,
+  learnerId: string
+) {
+  const rows = await listLearnerCardStates(institutionId, learnerId);
+  const grouped = new Map<string, { mastery: number; cards: number }>();
+  for (const row of rows) {
+    const key = row.competencyId ?? "general";
+    const stability = row.state?.stability ?? 1;
+    const retrievability = row.state?.retrievability ?? 0.8;
+    const mastery = Math.max(
+      0,
+      Math.min(1, 0.6 * retrievability + 0.4 * Math.min(1, stability / 30))
+    );
+    const current = grouped.get(key) ?? { mastery: 0, cards: 0 };
+    grouped.set(key, {
+      mastery:
+        (current.mastery * current.cards + mastery) / (current.cards + 1),
+      cards: current.cards + 1,
+    });
+  }
+  return Object.fromEntries(
+    Array.from(grouped.entries()).map(([key, value]) => [
+      key,
+      { mastery: Math.round(value.mastery * 100) / 100, cards: value.cards },
+    ])
+  );
+}
