+// â”€â”€ Knowledge-graph extraction (Studyield / OpenTutor LOOM idea, local) â”€â”€â”€â”€â”€â”€â”€
+export type ConceptCandidate = {
+  label: string;
+  occurrences: number;
+  evidence: string;
+};
+export type EdgeCandidate = {
+  from: string;
+  to: string;
+  weight: number;
