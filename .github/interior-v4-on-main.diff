+/**
+ * Quiz engine â€” the grading rules the learner's score depends on.
+ *
+ * These run without a database or network: the engine is pure, which is exactly why the same
+ * numbers show up in the attempt row, the roadmap and the XP total.
+ */
+import { describe, expect, it } from "vitest";
+import {
+  coerceAnswers,
+  freeTextMatches,
+  gradeQuiz,
+  normalizeItems,
+  parsePairs,
+  quizForStudent,
+} from "./quizEngine";
+
+const QUIZ_ID = "quiz_test";
+
+describe("normalizeItems", () => {
+  it("accepts the loose studio shape and infers the item type", () => {
+    const items = normalizeItems(
+      [
+        { q: "Pick the fluency measure", a: "WCPM", options: ["WCPM", "Pages"], explanation: "rate minus errors", ref: "chunk_1" },
+        { q: "True or false: rereading helps", a: "True", options: ["true", "false"] },
+        { q: "Fill: an ___ ticket", a: "exit" },
+        { q: "Match", a: ["a=1", "b=2"] },
+        { prompt: "junk row without an answer" },
+      ],
+      QUIZ_ID
+    );
+    expect(items.map(item => item.type)).toEqual(["mcq", "true_false", "fill_blank", "match"]);
+    expect(items).toHaveLength(4); // an item with no answer key is dropped, never guessed
+    expect(items[0].why).toBe("rate minus errors");
+    expect(items[0].sourceRef).toBe("chunk_1");
+    expect(items[2].options).toEqual([]);
+    expect(items[3].answer).toEqual(["a=1", "b=2"]);
+  });
+
+  it("ignores garbage instead of throwing", () => {
+    expect(normalizeItems(undefined, QUIZ_ID)).toEqual([]);
+    expect(normalizeItems("nope", QUIZ_ID)).toEqual([]);
+    expect(normalizeItems([null, { q: "", a: "x" }], QUIZ_ID)).toEqual([]);
+  });
+});
+
+describe("freeTextMatches", () => {
+  it("normalises case, punctuation and articles", () => {
+    expect(freeTextMatches("  The W.C.P.M. ", "wcpm")).toBe(true);
+    expect(freeTextMatches("w-c-p-m", "WCPM")).toBe(true);
+    expect(freeTextMatches("a rate", "rate")).toBe(true);
+    expect(freeTextMatches("theory", "rate")).toBe(false);
+    // A short answer is never accepted for "most of" a key â€” that is match-cell leniency only.
+    expect(freeTextMatches("the cat", "the cat sat")).toBe(false);
+  });
+
+  it("tolerates typos on long answers but not on short ones", () => {
+    expect(freeTextMatches("complere", "complete")).toBe(true); // one edit over 8 chars
+    expect(freeTextMatches("cat", "car")).toBe(false); // a three-letter key allows no edits
+    expect(freeTextMatches("fluently", "fluntly")).toBe(true);
+    expect(freeTextMatches("totally wrong answer", "totally right answer")).toBe(false);
+  });
+
+  it("accepts any of several accepted spellings, and never a loose short one", () => {
+    expect(freeTextMatches("colour", ["color", "colour"])).toBe(true);
+    expect(freeTextMatches("colour", ["color"])).toBe(false); // 6-letter key: tolerance is zero
+    expect(freeTextMatches("clour", ["color"])).toBe(false);
+    expect(freeTextMatches("acknowledgement", ["acknowledgment"])).toBe(true);
+  });
+});
