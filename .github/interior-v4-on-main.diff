+      ? `${lines} â€” (${plan.instruction}.)`
+      : `No cited evidence in the corpus for â€œ${plan.instruction}â€. Add or approve a source, then re-run.`,
+    citations: picked.map((_, index) => `S${index + 1}`),
+  };
+}
