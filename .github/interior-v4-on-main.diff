+      quizId: QUIZ_ID,
+      items,
+      answers: coerceAnswers(
+        [
+          { itemId: "m1", value: "words correct per minute" },
+          { itemId: "m2", value: "false" },
+          { itemId: "m3", value: "Exit  ticket." },
+          { itemId: "m4", value: ["a=1", "b = 2"] },
