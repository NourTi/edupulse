index 0000000..25e7597
--- /dev/null
+++ b/client/src/components/entryScreen.ts
@@ -0,0 +1,44 @@
+/**
+ * Which screen the app opens on, as a pure decision so it can be tested without a browser.
+ *
+ * The rule: the workspace IS the product, so it is never hidden behind the marketing hero.
+ *   - demo/guest mode  â†’ the interior, with the seeded staff identity signed in
+ *   - a real session   â†’ the interior, on the requested view if `?open=` asked for one
+ *   - nobody signed in â†’ the sign-in screen (one step, not a landing page to scroll)
+ * The public front door stays reachable at `?hero=1` / `/hero` (and from the sign-in screen), so a
+ * school visitor can still get to it â€” it is simply no longer the default wall in front of the app.
+ */
+export type EntryScreen = "landing" | "access" | "workspace";
+
+export type EntryInput = {
+  /** Server says guest/demo mode is active (auth.demoMode â†’ enabled). */
+  demoEnabled: boolean;
+  /** A session is in effect, or the desktop shell which always owns its own identity. */
+  signedIn: boolean;
+  /** `?hero=1` or `/hero` was requested. */
+  heroRequested: boolean;
+  /** View asked for by `?open=<view>`, if any. */
+  deepView: string | null;
+};
+
+export type EntryDecision = {
+  screen: EntryScreen;
+  /**
+   * View to open. It is kept even when the screen is not the workspace, because a deep link that
+   * arrives while signed out has to survive sign-in â€” the identity effect inside the app performs
+   * that hand-off, not this function.
+   */
+  view: string | null;
+};
+
+export function resolveEntry({
+  demoEnabled,
+  signedIn,
+  heroRequested,
+  deepView,
+}: EntryInput): EntryDecision {
+  if (heroRequested) return { screen: "landing", view: null };
+  if (demoEnabled) return { screen: "workspace", view: deepView };
+  if (signedIn) return { screen: "workspace", view: deepView };
+  return { screen: "access", view: deepView };
+}
