+/**
+ * Quiz engine â€” the learner-side practice loop, ported from OpenTutor's `apps/api/services/quizzes`
+ * behaviour (multi-type items, deterministic grading, wrong-answer diagnostics) rather than
+ * re-invented.
+ *
+ * Two rules carried over from that design, both deliberate:
+ *  1. Grading never uses a model. Fill-blank and short answers are compared to the key with
+ *     normalisation (case, punctuation, articles, acronyms) plus a bounded edit-distance window,
+ *     so a typo cannot cost a learner a correct answer and a hallucinated grader cannot invent one.
+ *  2. A wrong answer returns the item's own source note (`why`) instead of a generic "incorrect",
+ *     so the item becomes a teaching moment and the wrong-answer list becomes real input for the
+ *     FSRS queue, the remedial cards and the roadmap.
+ *
+ * Item types: mcq | true_false | fill_blank | match. The persisted shape stays a single array on
+ * `quizzes.itemsJson`; `quizForStudent()` is what the browser receives, with answers stripped.
+ */
+
+export type QuizItem = {
+  id: string;
+  type: "mcq" | "true_false" | "fill_blank" | "match";
+  prompt: string;
+  options: string[];
+  answer: string | string[];
+  why?: string;
+  sourceRef?: string;
+};
+
+export type StudentAnswer = {
+  itemId: string;
+  value: string | string[] | null;
+};
+
+export type GradedItem = {
+  itemId: string;
+  type: QuizItem["type"];
+  correct: boolean;
+  /** The learner's answer, echoed back for the review screen. */
+  given: string | string[] | null;
+  expected: string | string[];
+  why?: string;
+  sourceRef?: string;
+};
+
+export type QuizResult = {
+  quizId: string;
+  score: number;
+  total: number;
+  percent: number;
+  /** XP follows the same scale as card reviews, with a floor so a quiz counts as evidence. */
+  xp: number;
+  items: GradedItem[];
+  /** Item ids the learner missed â€” the payload for remedial cards and the roadmap. */
+  wrongItemIds: string[];
+  completedAt: string;
+};
+
+/**
+ * Characters that are never part of an answer. Built from code points on purpose: a literal
+ * class here once swallowed the letter "c" and silently broke every acronym comparison.
+ */
+const PUNCT = new Set(
+  [
+    33, 34, 39, 40, 41, 42, 44, 45, 46, 47, 58, 59, 63, 91, 92, 93, 95, 123, 125, 8203, 8211,
+    8212, 8216, 8217, 8220, 8221, 8230, 8594,
+  ].map(code => String.fromCharCode(code))
+);
+
+/** Case, punctuation and whitespace are not part of an answer. */
+function normalize(value: string): string {
+  let out = "";
+  for (const char of value.toLowerCase()) {
+    if (PUNCT.has(char)) {
+      if (!out.endsWith(" ")) out += " ";
+    } else {
+      out += char;
+    }
+  }
+  return out.replace(/\s+/g, " ").trim();
+}
+
+/**
+ * Leading articles are noise in a short-answer key ("a rate" == "rate"), but only as a whole
+ * word â€” stripping "the" from "theory" would grade a wrong answer as right.
+ */
+function stripArticles(value: string): string {
+  const match = /^(the|a|an|le|la|les|un|une)(\s|$)/i.exec(value);
+  if (!match) return value;
+  const rest = value.slice(match[0].length).trim();
+  return match[1].toLowerCase() === value.slice(0, match[1].length).toLowerCase() && rest ? rest : value;
+}
+
+/** Letters and digits only, so "W.C.P.M." and "w-c-p-m" both reduce to "wcpm". */
+function compact(value: string): string {
+  let out = "";
+  for (const char of value.toLowerCase()) {
+    const code = char.codePointAt(0) ?? 0;
+    const latin = (code >= 97 && code <= 122) || (code >= 48 && code <= 57);
+    const arabic = code >= 1536 && code <= 1567;
+    if (latin || arabic) out += char;
+  }
+  return out;
+}
+
+/** Bounded edit distance (Levenshtein) so a slip of one or two letters is not a wrong answer. */
+function editDistance(a: string, b: string, limit: number): number {
+  if (Math.abs(a.length - b.length) > limit) return limit + 1;
+  let previous = Array.from({ length: b.length + 1 }, (_, index) => index);
+  for (let i = 1; i <= a.length; i += 1) {
+    const current = [i];
+    for (let j = 1; j <= b.length; j += 1) {
+      const cost = a[i - 1] === b[j - 1] ? 0 : 1;
+      current[j] = Math.min(current[j - 1] + 1, previous[j] + 1, previous[j - 1] + cost);
+      if (current[j] > limit + 1) current[j] = limit + 2;
+    }
+    previous = current;
+  }
+  return previous[b.length] ?? limit + 1;
+}
+
+function asStrings(value: string | string[]): string[] {
+  return Array.isArray(value) ? value.map(entry => String(entry)) : [String(value)];
+}
+
+function matchCore(a: string, b: string, lenient: boolean): boolean {
+  if (!a || !b) return false;
+  if (a === b) return true;
+  const aa = stripArticles(a);
+  const ab = stripArticles(b);
+  if (aa === ab) return true;
+  const ca = compact(aa);
+  const cb = compact(ab);
+  if (ca && ca === cb) return true;
+  // Bounded by the longer side, so a five-letter answer cannot be "one edit" from anything.
+  const longer = Math.max(a.length, b.length);
+  const tolerance = longer <= 6 ? 0 : longer <= 12 ? 1 : 2;
+  if (editDistance(a, b, tolerance) <= tolerance) return true;
+  if (longer > 6 && ca.length > 3 && editDistance(ca, cb, 1) <= 1) return true;
+  // Only inside a match cell, whose expected side is a long phrase: an answer reproducing its
+  // leading run counts. A fill-blank key is never satisfied by half of itself.
+  return lenient && longer >= 8 && a.length >= 4 && b.startsWith(a);
+}
+
+/**
+ * Free-text grading. Accepts an exact match, an article/punctuation variant or a bounded typo.
+ * Never accepts a short answer by distance alone ("cat" != "car"), and never accepts half of the
+ * key â€” that leniency belongs to match cells only.
+ */
+export function freeTextMatches(given: string, expected: string | string[]): boolean {
+  const a = normalize(given);
+  return asStrings(expected).some(entry => matchCore(a, normalize(entry), false));
+}
+
+/**
+ * Matching answers are order-insensitive and separator-tolerant (`a=b`, `a â†’ b`, `a|b`, one pair
+ * per line or tab) â€” the way both the generator and a learner actually type them.
+ */
+export function parsePairs(value: string | string[]): Array<[string, string]> {
+  const raw = asStrings(value).join("\n");
+  return raw
+    .split(/[\n;\r]/)
+    .map(pair => pair.split(/=|â†’|:|\||\t/))
+    .map(parts => [parts[0]?.trim() ?? "", parts[1]?.trim() ?? ""] as [string, string])
+    .filter(pair => pair[0] && pair[1]);
+}
+
+function countCorrectPairs(given: string | string[], expected: string | string[]) {
+  const want = parsePairs(expected);
+  const got = new Map(parsePairs(given).map(pair => [normalize(pair[0]), pair[1]]));
+  let matched = 0;
+  for (const [left, right] of want) {
+    const candidate = got.get(normalize(left));
+    if (candidate !== undefined && matchCore(normalize(candidate), normalize(right), true)) {
+      matched += 1;
+    }
+  }
+  return { matched, total: want.length };
+}
+
+export function gradeItem(item: QuizItem, answer: StudentAnswer | undefined): GradedItem {
+  const given = answer?.value ?? null;
+  const base = {
+    itemId: item.id,
+    type: item.type,
+    given,
+    expected: item.answer,
+    why: item.why,
+    sourceRef: item.sourceRef,
+  };
+  const blank =
+    given === null ||
+    given === undefined ||
+    given === "" ||
+    (Array.isArray(given) && given.every(entry => !String(entry).trim()));
+  if (blank) return { ...base, correct: false };
+
+  switch (item.type) {
+    case "mcq":
+      return {
+        ...base,
+        correct: normalize(asStrings(given)[0] ?? "") === normalize(asStrings(item.answer)[0] ?? ""),
+      };
+    case "true_false": {
+      const truth = (value: string) => /^(true|yes|vrai|ØµØ­|Ù†Ø¹Ù…)$/i.test(value.trim());
+      return {
+        ...base,
+        correct: truth(asStrings(given)[0] ?? "") === truth(asStrings(item.answer)[0] ?? ""),
+      };
+    }
+    case "fill_blank": {
+      const expected = asStrings(item.answer);
+      const givenList = asStrings(given);
+      return { ...base, correct: expected.every((slot, index) => freeTextMatches(givenList[index] ?? "", slot)) };
+    }
+    case "match": {
+      const { matched, total } = countCorrectPairs(given, item.answer);
+      // Partial credit is honest here: 5 right pairs out of 6 is not a zero, but it is not a
+      // correct item either â€” the learner still has to see the missed pair on review.
+      return { ...base, correct: total > 0 && matched === total };
+    }
+    default:
+      return { ...base, correct: false };
+  }
+}
+
+/** Accepts loose learner input: a list of `{itemId, value}` or an `{itemId: value}` map. */
+export function coerceAnswers(
+  input: StudentAnswer[] | Record<string, unknown> | unknown,
+  items: QuizItem[]
+): StudentAnswer[] {
+  const byId = new Map(items.map(item => [item.id, item]));
+  if (Array.isArray(input)) {
+    return input
+      .map(row => {
+        const record = (row ?? {}) as Record<string, unknown>;
+        const itemId = String(record.itemId ?? "");
+        return byId.has(itemId)
+          ? { itemId, value: (record.value as string | string[] | null) ?? null }
+          : null;
+      })
+      .filter((row): row is StudentAnswer => row !== null);
+  }
+  if (input && typeof input === "object") {
+    return Object.entries(input as Record<string, unknown>)
+      .filter(([itemId]) => byId.has(itemId))
+      .map(([itemId, value]) => ({ itemId, value: value as string | string[] | null }));
+  }
+  return [];
+}
+
+export function gradeQuiz(input: {
+  quizId: string;
+  items: QuizItem[];
+  answers: StudentAnswer[] | Record<string, unknown>;
+}): QuizResult {
+  const answers = Array.isArray(input.answers)
+    ? input.answers
+    : coerceAnswers(input.answers, input.items);
+  const byId = new Map(answers.map(answer => [answer.itemId, answer]));
+  const items = input.items.map(item => gradeItem(item, byId.get(item.id)));
+  const score = items.filter(item => item.correct).length;
+  const total = items.length;
+  return {
+    quizId: input.quizId,
+    score,
+    total,
+    percent: total ? Math.round((score / total) * 100) : 0,
+    // A finished attempt is worth at least one focus session (80 XP) so a four-item quiz is not
+    // pointless, capped at 150 so nobody farms XP by retaking the same items.
+    xp: Math.min(150, Math.max(80, score * 10)),
+    items,
+    wrongItemIds: items.filter(item => !item.correct).map(item => item.itemId),
+    completedAt: new Date().toISOString(),
+  };
+}
+
+/** What the learner's browser is allowed to see: no answers, no explanations. */
+export function quizForStudent(items: QuizItem[]) {
+  return items.map(item => ({
+    id: item.id,
+    type: item.type,
+    prompt: item.prompt,
+    options: item.type === "true_false" ? ["True", "False"] : item.options,
+    ...(item.type === "match"
+      ? {
+          left: parsePairs(item.answer).map(pair => pair[0]),
+          right: parsePairs(item.answer)
+            .map(pair => pair[1])
+            .sort(() => 0.5 - Math.random()),
+        }
+      : {}),
+  }));
+}
+
+/**
+ * Normalise the loose shapes the studio and the LLM prompt produce (`{q, a, options, explanation,
+ * ref}`) into typed items. Anything without a usable answer is dropped rather than graded wrong.
+ */
+export function normalizeItems(raw: unknown, quizId: string): QuizItem[] {
+  const list = Array.isArray(raw) ? raw : [];
+  const out: QuizItem[] = [];
+  list.forEach((entry, index) => {
+    const item = (entry ?? {}) as Record<string, unknown>;
+    const prompt = String(item.q ?? item.prompt ?? "").trim();
+    const answer = item.answer ?? item.correct ?? item.a;
+    if (!prompt || answer === undefined || answer === null) return;
+    const options = Array.isArray(item.options)
+      ? item.options.map(option => String(option))
+      : Array.isArray(item.choices)
+        ? item.choices.map(option => String(option))
+        : [];
+    const answerText: string | string[] = Array.isArray(answer)
+      ? answer.map(entry => String(entry))
+      : String(answer);
+    const declared = String(item.type ?? "").toLowerCase();
+    let type: QuizItem["type"] =
+      declared === "true_false" || declared === "tf"
+        ? "true_false"
+        : declared === "match" || declared === "matching"
+          ? "match"
+          : declared === "fill_blank" || declared === "cloze" || declared === "fill-in-blank"
+            ? "fill_blank"
+            : "mcq";
+    // Infer when the generator did not label. An unlabelled item with no options is graded as
+    // free text (the lenient path, never a silent "wrong"); a list of pairs is a match item.
+    if (type === "mcq" && !options.length) {
+      const pairLike =
+        Array.isArray(answer) && answer.length > 1 && answer.every(entry => /[=|â†’]/.test(String(entry)));
+      type = pairLike ? "match" : "fill_blank";
+    }
+    if (
+      type === "fill_blank" &&
+      options.length <= 1 &&
+      /^(true|false|yes|no|vrai|faux|ØµØ­|Ø®Ø·Ø£|Ù†Ø¹Ù…)$/i.test(asStrings(answerText)[0]?.trim() ?? "")
+    ) {
+      type = "true_false";
+    }
+    if (type === "mcq" && options.length === 2) {
+      const set = new Set(options.map(option => option.toLowerCase()));
+      if (set.has("true") && set.has("false")) type = "true_false";
+    }
+    const graded: QuizItem = {
+      id: String(item.id ?? `${quizId}_i${index + 1}`),
+      type,
+      prompt,
+      options:
+        type === "true_false"
+          ? options.length === 2
+            ? options
+            : ["True", "False"]
+          : type === "mcq" || type === "match"
+            ? options
+            : [],
+      answer: answerText,
+    };
+    const why = item.explanation ?? item.why;
+    if (why) graded.why = String(why);
+    const ref = item.ref ?? item.sourceRef;
+    if (ref) graded.sourceRef = String(ref);
+    out.push(graded);
+  });
+  return out;
+}
