+      },
+    });
+    // mcq wrong, tf right, fill-blank half-typed (rejected), match 1/2 (partial but not correct).
+    expect(result.score).toBe(1);
+    expect(result.wrongItemIds.sort()).toEqual(["m1", "m3", "m4"]);
+    const match = result.items.find(item => item.itemId === "m4");
+    expect(match?.correct).toBe(false);
+    expect(match?.expected).toEqual(["a|1", "b|2"]);
